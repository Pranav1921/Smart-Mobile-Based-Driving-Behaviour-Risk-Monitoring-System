@echo off
title Smart Driving Behaviour & Risk Monitoring System - Node Modules Auto-Repair
echo ========================================================
echo   Smart Driving Behaviour & Risk Monitoring System
echo   Repairing Corrupted Node Modules
echo ========================================================
echo.

echo [1/3] Performing clean reinstall for Backend dependencies...
cd backend
if exist node_modules (
    echo Removing corrupted backend node_modules...
    rd /s /q node_modules
)
echo Installing fresh backend packages...
call npm install
echo Generating Prisma client...
call npx prisma generate --schema=src/prisma/schema.prisma
cd ..

echo.
echo [2/3] Performing clean reinstall for Admin Dashboard dependencies...
cd dashboard
if exist node_modules (
    echo Removing corrupted dashboard node_modules...
    rd /s /q node_modules
)
echo Installing fresh dashboard packages...
call npm install
cd ..

echo.
echo [3/3] Performing clean reinstall for Driver Dashboard dependencies...
cd web\driver-dashboard
if exist node_modules (
    echo Removing corrupted driver dashboard node_modules...
    rd /s /q node_modules
)
echo Installing fresh driver dashboard packages...
call npm install --legacy-peer-deps
cd ..\..

echo.
echo ========================================================
echo   All node modules repaired successfully!
echo   You can now launch the app using run_system.bat
echo ========================================================
pause
