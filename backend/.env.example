# Server Configuration
PORT=3000
NODE_ENV=development

# Database Settings
# For Docker Compose: postgresql://postgres:postgres@db:5432/fleetguard_db?schema=public
# For Local: postgresql://postgres:postgres@localhost:5432/fleetguard_db?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fleetguard_db?schema=public"

# Redis Cache & Queue Settings
# For Docker Compose: redis://redis:6379
# For Local: redis://127.0.0.1:6379
REDIS_URL="redis://127.0.0.1:6379"

# JWT Authentication Secrets
JWT_ACCESS_SECRET="super-secret-access-key-fleetguard-ai-2026"
JWT_REFRESH_SECRET="super-secret-refresh-key-fleetguard-ai-2026"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# Media Storage Settings
# Set up Cloudinary or leave blank to automatically fall back to local disk storage
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Local Disk Storage Configuration (if Cloudinary is empty)
LOCAL_STORAGE_DIR="./uploads"

# AI/ML Analytics Engine Integration
AI_SERVICE_URL="http://localhost:5000"
